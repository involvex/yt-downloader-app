{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt-dlp Desktop",
  "version": "0.1.0",
  "identifier": "com.involvex.downloader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yt-dlp Desktop",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/yt-dlp", "binaries/ffmpeg"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "publisher": "involvex",
        "installMode": "perUser"
      }
    }
  }
}
