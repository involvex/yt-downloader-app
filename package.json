{
  "name": "downloader-app",
  "private": true,
  "version": "0.1.0",
  "author": "involvex",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "bun run typecheck && bun run lint && bun run format:check",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exe": "bun run tauri build --debug && if (-not (Test-Path releases)) { New-Item -ItemType Directory -Path releases | Out-Null } && Copy-Item src-tauri/target/release/downloader-app.exe releases/ -Force",
    "build:msi": "bun run tauri build --debug && if (-not (Test-Path releases)) { New-Item -ItemType Directory -Path releases | Out-Null } && Copy-Item src-tauri/target/release/bundle/nsis/*.exe releases/ -Force"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.33.0",
    "vite": "^8.0.16"
  }
}
