    "@tauri-apps/plugin-store": "^2.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/node": "26.4.1",
    "@types/bun": "1.4.1",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^16.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14",
