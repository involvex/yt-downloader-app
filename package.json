{
  "name": "downloader-app",
  "private": true,
  "version": "0.1.0",
  "author": "involvex",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prebuild": "bun run typecheck && bun run lint:fix && bun run format",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:exe": "bunx tauri build && bun scripts/copy-build.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
